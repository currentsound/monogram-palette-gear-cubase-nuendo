{"version":"3.0","id":"lapq2Q2IAtjDL2gG_sK1L","title":"Premiere Edit","app":"com.adobe.premierepro","assignments":{"core":[{"fixedPosition":true,"submodules":{},"settings":{"color":"#0cebeb","info":"Razors/cuts all tracks at the playhead.","label":"Razor","name":"Razor All Tracks","press":{"key":"k","localCharacter":"k","modifiers":["control"],"virtual":false}}}],"button":[{"fixedPosition":true,"submodules":{},"settings":{"color":"#0cebeb","info":"Razors/cuts all tracks at the playhead.","label":"Razor","name":"Razor All Tracks","press":{"key":"k","localCharacter":"k","modifiers":["control"],"virtual":false}}},{"fixedPosition":true,"submodules":{},"settings":{"color":"#0cebeb","info":"This deletes the clip selected in the timeline panel. Any gap that is created is closed.","name":"Editing.Ripple Delete","press":{"input":"Editing.Ripple Delete"}}}],"slider":[{"fixedPosition":true,"submodules":{},"settings":{"color":"#ff00ff","info":"Dial: Turn to shuttle the play head left and right, press to stop. Slider: Move left or right to shuttle at increasing speeds in either direction, move back to the middle to stop.","name":"Playback/Navigation.Shuttle","pose":{"input":"Audio Mixer.Volume.Audio 1 (A1) Track","invert":false,"range":[0,25]}}},{"fixedPosition":true,"submodules":{},"settings":{"color":"#ff00ff","info":"Changes the volume of the Audio 3 Track. Set a button to Toggle Mixer Control Mode to switch between the track and clip mixer.","name":"Audio Mixer.Volume.Audio 3 (A3) Track","pose":{"input":"Audio Mixer.Volume.Audio 3 (A3) Track","range":[0,255]}}},{"fixedPosition":true,"submodules":{},"settings":{"color":"#ff00ff","info":"Changes the opacity of the selected clip. Keyframing is on by default in Premiere Pro.","name":"Opacity.Opacity","pose":{"input":"Audio Mixer.Volume.Audio 2 (A2) Track","invert":false,"range":[0,25]}}}],"dial":[{"fixedPosition":true,"submodules":{},"settings":{"color":"#0000ff","doubleTap":["Motion.Position Y","reset"],"info":"Changes the vertical position of the selected clip.","name":"Motion.Position Y","press":{"action":"reset","input":"Motion.Position Y"},"pressAndTurn":{"input":"Motion.Position Y","step":10},"turn":{"input":"Motion.Position Y","step":1}}},{"fixedPosition":true,"submodules":{},"settings":{"color":"#0000ff","info":"Zooms in (dial right turn) or zooms out (dial left turn) on the playhead in the timeline.","name":"Playback/Navigation.Timeline.Zoom In/Out on Timeline","pressAndTurn":{"input":"Playback/Navigation.Timeline.Zoom In/Out on Timeline","step":10},"turn":{"input":"Playback/Navigation.Timeline.Zoom In/Out on Timeline","step":1}}},{"fixedPosition":true,"submodules":{},"settings":{"color":"#0000ff","info":"This moves the playhead frame by frame in the selected monitor. Press down and turn to jump through multiple frames. Press to toggle playback.","name":"Playhead","press":{"input":"Playback/Navigation.Play/Stop"},"pressAndTurn":{"input":"Playhead","step":10},"turn":{"input":"Playhead","step":1}}}]},"tags":[],"notes":""}